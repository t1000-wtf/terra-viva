# TerraViva Backend - Variáveis de Ambiente

# Configurações Gerais
PROJECT_NAME="TerraViva Backend"
VERSION="1.1.0"
API_V1_STR="/api/v1"

# Segurança
# OBRIGATÓRIO EM PRODUÇÃO: Gere com `openssl rand -hex 32` ou chave de 32+ caracteres
SECRET_KEY="sua-chave-secreta-de-producao-deve-ter-mais-de-32-caracteres"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Banco de Dados (SQLite para dev, PostgreSQL/PostGIS para produção)
DATABASE_URL="sqlite:///./terraviva.db"
# DATABASE_URL="postgresql+psycopg2://terraviva:senha@localhost:5432/terraviva_db"

# APIs de IA e Sensoriamento Remoto
GEMINI_API_KEY=""
NASA_EARTHDATA_TOKEN=""

# Endpoints Oficiais
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/daily/point"
IBGE_API_BASE_URL="https://servicodados.ibge.gov.br/api/v1"
IBGE_AGREGADOS_BASE_URL="https://servicodados.ibge.gov.br/api/v3/agregados"
INMET_API_BASE_URL="https://apitempo.inmet.gov.br"
